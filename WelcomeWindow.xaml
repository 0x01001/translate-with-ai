<!-- WelcomeWindow.xaml -->

<Window x:Class="ReWrite.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReWrite"
        Height="240"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="False"> <!-- Giữ False để Windows tự quản lý phần bo góc và đổ bóng -->

    <!-- Cấu hình WindowChrome để xóa bỏ thanh tiêu đề nhưng giữ lại viền và tính năng hệ thống -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Giữ nguyên cấu trúc giao diện gốc của bạn -->
    <Grid Background="#0F1115">

        <Grid>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Image Width="72"
                    Height="72"
                    Source="pack://siteoforigin:,,,/ui/logo.png"
                    Margin="0,0,0,12" />

                <TextBlock Text="ReWrite"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#F3F4F6"
                        HorizontalAlignment="Center" />

                <TextBlock x:Name="StatusText"
                        Text="Dang khoi dong ung dung..."
                        FontSize="12"
                        Foreground="#9CA3AF"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center" />

                <ProgressBar x:Name="LoadingBar"
                            Height="6"
                            Width="160"
                            Margin="0,12,0,0"
                            IsIndeterminate="True"
                            Foreground="#EC4899"
                            Background="#1B1F27" />

                <Button x:Name="CloseButton"
                        Content="Dong"
                        Width="120"
                        Height="30"
                        Margin="0,12,0,0"
                        Background="#EC4899"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Visibility="Collapsed" />

            </StackPanel>

        </Grid>

    </Grid>
</Window>
